<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1A"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical"
            android:background="#0D1B2A"
            android:padding="4">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WAHID VR KAMERA"
                android:textColor="#00D4FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="8"
                android:background="#0088CC"
                android:gravity="center" />

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#1A1A2E"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="Cari Efek..."
                android:padding="8dp"
                android:layout_margin="4dp"
                android:singleLine="true"
                android:inputType="text"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#1A1A2E"
                android:layout_margin="4dp" />

            <ScrollView
                android:id="@+id/scrollEffects"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:scrollbarThumbVertical="#00D4FF">

                <LinearLayout
                    android:id="@+id/effectList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4" />

            </ScrollView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:orientation="vertical"
            android:padding="4">

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#000000" />

            <TextView
                android:id="@+id/effectInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Original"
                android:textColor="#00D4FF"
                android:textSize="14sp"
                android:padding="8"
                android:gravity="center"
                android:background="#0D1B2A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8"
                android:background="#0A0A1A">

                <ImageButton
                    android:id="@+id/captureBtn"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/circle_button_green"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:layout_margin="8dp" />

                <ImageButton
                    android:id="@+id/switchBtn"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="@drawable/circle_button_blue"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:layout_margin="8dp" />

                <ImageButton
                    android:id="@+id/clearBtn"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="@drawable/circle_button_red"
                    android:scaleType="centerInside"
                    android:padding="14dp"
                    android:layout_margin="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
