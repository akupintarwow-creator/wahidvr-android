# Cell 5: Download APK
import shutil
import os

apk_path = 'bin'
for f in os.listdir(apk_path):
    if f.endswith('.apk'):
        src = os.path.join(apk_path, f)
        dst = f'/content/{f}'
        shutil.copy(src, dst)
        print(f'✅ APK tersedia: {dst}')
        print(f'📥 Klik link download di sebelah kiri file panel')
